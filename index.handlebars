<h1 class="text-center mb-3">{{title}}</h1>

<!-- Search & Filter Bar -->
<div class="filter-bar mb-4">
  <input type="text" id="searchBox" class="form-control" placeholder="🔍 Search by company or role..." />
  <select id="statusFilter" class="form-control mt-2">
    <option value="">All Statuses</option>
    <option value="Applied">Applied</option>
    <option value="Phone Screen">Phone Screen</option>
    <option value="Technical">Technical</option>
    <option value="Offer">Offer</option>
    <option value="Rejected">Rejected</option>
  </select>
</div>

<!-- Add Application Form -->
<div class="card mb-4">
  <div class="card-header"><strong>➕ Add New Application</strong></div>
  <div class="card-body">
    <form action="/api/applications" method="POST">
      <div class="form-row">
        <div class="form-group col-md-6">
          <label>Name</label>
          <input type="text" name="name" class="form-control" placeholder="e.g. Ishaan Sengupta" required>
        </div>
        <div class="form-group col-md-6">
          <label>Role</label>
          <input type="text" name="role" class="form-control" placeholder="e.g. Software Engineer Intern" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group col-md-6">
          <label>Company</label>
          <input type="text" name="company" class="form-control" placeholder="e.g. Mastercard" required>
        </div>
        <div class="form-group col-md-4">
          <label>Status</label>
          <select name="status" class="form-control" required>
            <option value="">-- Select Status --</option>
            <option value="Applied">Applied</option>
            <option value="Phone Screen">Phone Screen</option>
            <option value="Technical">Technical</option>
            <option value="Offer">Offer</option>
            <option value="Rejected">Rejected</option>
          </select>
        </div>
      </div>
      <input type="submit" value="Add Application" class="btn btn-primary">
    </form>
  </div>
</div>

<!-- Stats Bar -->
<div class="stats-bar mb-4">
  <span class="stat-pill">Total: <strong id="totalCount">0</strong></span>
  <span class="stat-pill applied-pill">Applied: <strong id="appliedCount">0</strong></span>
  <span class="stat-pill phone-pill">Phone Screen: <strong id="phoneCount">0</strong></span>
  <span class="stat-pill technical-pill">Technical: <strong id="technicalCount">0</strong></span>
  <span class="stat-pill offer-pill">Offer: <strong id="offerCount">0</strong></span>
  <span class="stat-pill rejected-pill">Rejected: <strong id="rejectedCount">0</strong></span>
</div>

<!-- ── Confirmation Modal ──────────────────────────────────────────────────── -->
<div id="confirmModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.55); z-index:9999; justify-content:center; align-items:center;">
  <div style="background:#fff; border-radius:14px; padding:32px 28px; max-width:420px; width:90%;
              text-align:center; box-shadow:0 12px 40px rgba(0,0,0,0.25);">
    <div style="font-size:2rem; margin-bottom:10px;">🗑️</div>
    <h5 style="margin-bottom:8px; font-weight:700;">Delete Application</h5>
    <p style="color:#555; margin-bottom:28px; font-size:0.95rem;">
      Are you sure you want to delete this application?<br>
      <span style="color:#e53e3e; font-size:0.85rem;">This action cannot be undone.</span>
    </p>
    <div style="display:flex; gap:12px; justify-content:center;">
      <button id="confirmCancel" class="btn btn-secondary" style="min-width:100px;">Cancel</button>
      <button id="confirmDelete" class="btn btn-danger"    style="min-width:100px;">Confirm</button>
    </div>
  </div>
</div>

<!-- Applications List -->
<h4 class="mb-3">Applications</h4>
<ul class="list-group" id="applicationsList">
  {{#each applications}}
  <li class="list-group-item application-item"
      data-company="{{this.company}}"
      data-role="{{this.role}}"
      data-status="{{this.status}}">

    <!-- Header row: name + badge -->
    <div class="app-header">
      <div>
        <h5 class="mb-1">{{this.name}}</h5>
        <p class="mb-1 text-muted">{{this.role}} — {{this.company}}</p>
        <small class="text-muted">
          Applied: {{formatDate this.date_applied}} &nbsp;|&nbsp;
          Last updated: {{formatDate this.status_updated}}
        </small>
      </div>
      <span class="badge badge-status badge-{{this.status}}">{{this.status}}</span>
    </div>

    <!-- Action buttons -->
    <div class="app-actions mt-2">
      <!-- Delete — triggers modal -->
      <form action="/api/applications/delete/{{this.id}}" method="POST"
            style="display:inline;" class="delete-form">
        <button type="button" class="btn btn-sm btn-danger delete-btn">🗑 Delete</button>
      </form>

      <!-- Edit toggle -->
      <button class="btn btn-sm btn-warning"
              onclick="toggleEdit('edit-{{this.id}}')">✏️ Edit</button>
    </div>

    <!-- Edit form (hidden by default) -->
    <div id="edit-{{this.id}}" class="edit-form mt-3" style="display:none;">
      <form action="/api/applications/{{this.id}}" method="POST">
        <input type="hidden" name="_method" value="PUT">
        <div class="form-row">
          <div class="form-group col-md-6">
            <label>Role</label>
            <input type="text" name="role" class="form-control" value="{{this.role}}" required>
          </div>
          <div class="form-group col-md-6">
            <label>Company</label>
            <input type="text" name="company" class="form-control" value="{{this.company}}" required>
          </div>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="status" class="form-control" required>
            <option value="Applied"      {{#ifEq this.status "Applied"}}selected{{/ifEq}}>Applied</option>
            <option value="Phone Screen" {{#ifEq this.status "Phone Screen"}}selected{{/ifEq}}>Phone Screen</option>
            <option value="Technical"    {{#ifEq this.status "Technical"}}selected{{/ifEq}}>Technical</option>
            <option value="Offer"        {{#ifEq this.status "Offer"}}selected{{/ifEq}}>Offer</option>
            <option value="Rejected"     {{#ifEq this.status "Rejected"}}selected{{/ifEq}}>Rejected</option>
          </select>
        </div>
        <button type="submit" class="btn btn-sm btn-success">💾 Save Changes</button>
        <button type="button" class="btn btn-sm btn-secondary"
                onclick="toggleEdit('edit-{{this.id}}')">Cancel</button>
      </form>
    </div>

  </li>
  {{/each}}
</ul>

<!-- Export + API link -->
<div class="mt-4 mb-5">
  <a href="/api/applications/export" class="btn btn-success">⬇️ Export to CSV</a>
  <a href="/api/applications" class="btn btn-link ml-2">View API (JSON)</a>
</div>

<script>
  // ── Confirmation Modal ───────────────────────────────────────────────────────
  let pendingDeleteForm = null;
  const modal = document.getElementById('confirmModal');

  // Attach click handler to every delete button
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      pendingDeleteForm = this.closest('.delete-form');
      modal.style.display = 'flex';
    });
  });

  // Confirm — submit the stored form
  document.getElementById('confirmDelete').addEventListener('click', function () {
    if (pendingDeleteForm) pendingDeleteForm.submit();
    modal.style.display = 'none';
  });

  // Cancel — close modal, do nothing
  document.getElementById('confirmCancel').addEventListener('click', function () {
    pendingDeleteForm = null;
    modal.style.display = 'none';
  });

  // Click backdrop to cancel
  modal.addEventListener('click', function (e) {
    if (e.target === modal) {
      pendingDeleteForm = null;
      modal.style.display = 'none';
    }
  });

  // ── Toggle edit form ─────────────────────────────────────────────────────────
  function toggleEdit(id) {
    const form = document.getElementById(id);
    form.style.display = form.style.display === 'none' ? 'block' : 'none';
  }

  // ── Search + filter ──────────────────────────────────────────────────────────
  function applyFilters() {
    const searchVal = document.getElementById('searchBox').value.toLowerCase();
    const statusVal = document.getElementById('statusFilter').value.toLowerCase();
    document.querySelectorAll('.application-item').forEach(item => {
      const matchSearch = item.dataset.company.toLowerCase().includes(searchVal) ||
                          item.dataset.role.toLowerCase().includes(searchVal);
      const matchStatus = !statusVal || item.dataset.status.toLowerCase() === statusVal;
      item.style.display = matchSearch && matchStatus ? '' : 'none';
    });
    updateCounts();
  }

  // ── Live stats ───────────────────────────────────────────────────────────────
  function updateCounts() {
    let total = 0, applied = 0, phone = 0, technical = 0, offer = 0, rejected = 0;
    document.querySelectorAll('.application-item').forEach(item => {
      if (item.style.display === 'none') return;
      total++;
      const s = item.dataset.status;
      if (s === 'Applied')      applied++;
      else if (s === 'Phone Screen') phone++;
      else if (s === 'Technical')    technical++;
      else if (s === 'Offer')        offer++;
      else if (s === 'Rejected')     rejected++;
    });
    document.getElementById('totalCount').textContent     = total;
    document.getElementById('appliedCount').textContent   = applied;
    document.getElementById('phoneCount').textContent     = phone;
    document.getElementById('technicalCount').textContent = technical;
    document.getElementById('offerCount').textContent     = offer;
    document.getElementById('rejectedCount').textContent  = rejected;
  }

  document.getElementById('searchBox').addEventListener('input', applyFilters);
  document.getElementById('statusFilter').addEventListener('change', applyFilters);
  updateCounts();
</script>
